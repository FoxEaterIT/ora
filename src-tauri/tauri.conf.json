{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ora Desktop",
  "version": "0.1.0",
  "identifier": "com.ora.desktop",
  "build": { "beforeDevCommand": "npm run desktop:dev", "devUrl": "http://localhost:33334", "frontendDist": "./" },
  "app": {
    "windows": [{ "title": "Ora Timer", "width": 380, "height": 680, "minWidth": 340, "minHeight": 560, "resizable": true }],
    "security": { "csp": "default-src 'self'; connect-src 'self' http://localhost:* https:; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": true, "targets": ["msi", "nsis"] }
}
