{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ora Desktop",
  "version": "2.0.0",
  "identifier": "com.ora.desktop",
  "build": { "beforeDevCommand": "npm run desktop:dev", "devUrl": "http://localhost:33334", "beforeBuildCommand": "npm run desktop:build:frontend", "frontendDist": "./frontend-dist" },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "title": "Ora Timer", "width": 440, "height": 760, "minWidth": 380, "minHeight": 620, "resizable": true, "devtools": false }],
    "security": { "csp": "default-src 'self'; connect-src 'self' http: https:; img-src 'self' data: https:; style-src 'self'; script-src 'self'" }
  },
  "bundle": { "active": true, "targets": ["msi", "nsis"], "icon": ["icons/icon.png", "icons/icon.ico"], "windows": { "nsis": { "displayLanguageSelector": false } } }
}
