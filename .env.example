# Porta HTTP dell'app (Next.js usa PORT anche per start e dev)
PORT="33333"
# Database SQLite locale: relativo alla cartella prisma dell'installazione
DATABASE_URL="file:./dev.db"
# Lasciare vuote entrambe per creare l'owner tramite /setup al primo avvio,
# oppure configurarle entrambe per il provisioning iniziale da ambiente.
OWNER_EMAIL=""
OWNER_PASSWORD=""
OWNER_NAME="Owner"
# In produzione: generare un valore casuale, ad esempio `openssl rand -base64 32`.
AUTH_SECRET="replace-with-a-long-random-secret"

# Brand (NEXT_PUBLIC_* viene incluso nel bundle client: configurare prima del build)
NEXT_PUBLIC_APP_NAME="Ora"
NEXT_PUBLIC_APP_TAGLINE="Time tracking"
NEXT_PUBLIC_APP_DESCRIPTION="Traccia ore di progetti, team e persone con Ora."
# Loghi personalizzati: inserire i file esclusivamente in public/custom e indicare il percorso, es. /custom/logo-light.svg
NEXT_PUBLIC_APP_LOGO_LIGHT=""
NEXT_PUBLIC_APP_LOGO_DARK=""
NEXT_PUBLIC_DEFAULT_THEME="ora-default"

# Temi light disponibili separati da virgola. ora-default è sempre incluso.
# Opzioni aggiuntive: ora-blue, ora-green, ora-purple, ora-orange
NEXT_PUBLIC_ORA_THEMES="ora-blue,ora-green,ora-purple,ora-orange"
NEXT_PUBLIC_THEME_DEFAULT_LABEL="Ora - default"
NEXT_PUBLIC_THEME_DEFAULT_COLOR="#5b5bd6"
NEXT_PUBLIC_THEME_BLUE_LABEL="Ora blu"
NEXT_PUBLIC_THEME_BLUE_COLOR="#2878c7"
NEXT_PUBLIC_THEME_GREEN_LABEL="Ora verde"
NEXT_PUBLIC_THEME_GREEN_COLOR="#318454"
NEXT_PUBLIC_THEME_PURPLE_LABEL="Ora viola"
NEXT_PUBLIC_THEME_PURPLE_COLOR="#8051b5"
NEXT_PUBLIC_THEME_ORANGE_LABEL="Ora arancione"
NEXT_PUBLIC_THEME_ORANGE_COLOR="#c96c2c"
SESSION_COOKIE_NAME="ora_session"
SESSION_DURATION_DAYS="7"
PASSWORD_HASH_ROUNDS="10"
APP_ORIGIN="http://localhost:33333"
NEXT_PUBLIC_DEFAULT_PROJECT_COLOR="#14b8a6"
NEXT_PUBLIC_DEFAULT_TEAM_COLOR="#6366f1"
NEXT_PUBLIC_PROJECT_COLORS="#14b8a6,#5b5bd6,#f97316,#e11d48,#0ea5e9,#84cc16,#a855f7"
NEXT_PUBLIC_TEAM_COLORS="#6366f1,#0ea5e9,#f97316,#14b8a6,#e11d48,#a855f7"
