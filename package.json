{
  "name": "ora",
  "version": "1.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --hostname 127.0.0.1",
    "desktop:dev": "next dev --turbopack --hostname 127.0.0.1 -p 33334",
    "desktop:build:frontend": "node scripts/build-desktop-frontend.mjs",
    "build": "prisma generate && prisma migrate deploy && next build --turbopack",
    "start": "prisma migrate deploy && next start --hostname 127.0.0.1",
    "lint": "eslint",
    "check:i18n": "tsx src/i18n/check-messages.ts",
    "test": "tsx --test --test-timeout=180000 tests/*.test.ts"
  },
  "dependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tauri-apps/api": "^2.12.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "postcss": "^8.5.32",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
